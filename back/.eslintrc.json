{
    "env": {
      "node": true,
      "es2021": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:prettier/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "warn",
      "no-var": "error",
      "prefer-const": "error",
      "arrow-body-style": "off",
      "prefer-arrow-callback": "off"
    },
    "overrides": [
      {
        "files": ["**/*.test.js", "**/*.spec.js"],
        "env": {
          "jest": true
        }
      }
    ]
  }